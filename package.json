{
  "name": "dinnerpad",
  "version": "0.2.0",
  "description": "오프라인으로 쓰는 런치패드형 사운드보드",
  "main": "main.js",
  "license": "MIT",
  "author": "10000sun",
  "repository": {
    "type": "git",
    "url": "https://github.com/10000sun/dinnerpad.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.dinnerpad.app",
    "productName": "Dinnerpad",
    "files": [
      "main.js",
      "config.js",
      "preload.js",
      "accel.js",
      "renderer.js",
      "index.html",
      "style.css",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dinnerpad-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Dinnerpad-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
